@page "/login"
@using MeteoApp.Services
@inject LoginService loginServices
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="card shadow-lg mx-auto" style="max-width: 400px; border-radius: 20px;">
        <div class="card-body p-5 text-center">
            <h2 class="mb-4">Connexion</h2>
            
            <input type="text" class="form-control mb-3" placeholder="Votre nom" @bind="username" />
            
            <input type="password" class="form-control mb-3" placeholder="Mot de passe" @bind="password" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2 small">@errorMessage</div>
            }

            <button class="btn btn-primary w-100" @onclick="HandleLogin">Se connecter</button>
        </div>
    </div>
</div>

@code {
    // Propriétés pour stocker les entrées de l'utilisateur et les messages d'erreur
    private string username = "";
    private string password = "";
    private string errorMessage = "";


    // Méthode pour gérer la connexion
    private void HandleLogin() {
        
        
        bool isSuccess = loginServices.Login(username, password);

        if (isSuccess) {
            Nav.NavigateTo("/");
        } else {
            
            errorMessage = "Identifiants incorrects (Essaye 'admin' / 'Admin@2026')";
        }
    }
}